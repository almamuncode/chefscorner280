# Public canonical URL, including https:// and no trailing slash.
NEXT_PUBLIC_SITE_URL=https://chefscorneronmain.com
# Create an API key at resend.com and verify your sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Chef's Corner <website@your-verified-domain.com>
# Optional override for testing; defaults to the restaurant email in src/data/site.ts.
INQUIRY_TO_EMAIL=chefscorneronmain@gmail.com
